<?xml version="1.0" encoding="utf-8"?>
<!-- 本地视频「左侧目录栏」item：窄版布局，适配左侧约 1/3 屏宽，id 与 FolderAdapter 保持一致 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item"
    android:layout_width="match_parent"
    android:layout_height="@dimen/drive_vs_120"
    android:background="@drawable/drive_shape_setting_model_focus"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:nextFocusRight="@+id/rv_video"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/drive_vs_15"
    android:paddingRight="@dimen/drive_vs_15">

    <androidx.cardview.widget.CardView
        android:id="@+id/iv_container"
        android:layout_width="@dimen/drive_vs_180"
        android:layout_height="@dimen/drive_vs_120"
        android:layout_gravity="center_vertical"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="@dimen/drive_vs_5"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false">

        <ImageView
            android:id="@+id/iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/drive_iv_video" />
    </androidx.cardview.widget.CardView>

    <!-- 目录名过长时跑马灯滚动（焦点在该项时滚动，其余正常截断） -->
    <com.github.tvbox.osc.drive.localvideo.widget.DriveMarqueeTextView
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/drive_vs_15"
        android:layout_marginLeft="@dimen/drive_vs_15"
        android:layout_weight="1"
        android:focusable="false"
        android:gravity="start|center_vertical"
        android:textColor="@color/drive_dialog_text_primary"
        android:textSize="@dimen/drive_ts_22"
        tools:text="Movies" />

    <TextView
        android:id="@+id/tv_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/drive_vs_10"
        android:layout_marginLeft="@dimen/drive_vs_10"
        android:focusable="false"
        android:textColor="@color/drive_color_FFFFFF_70"
        android:textSize="@dimen/drive_ts_16"
        tools:text="10" />
</LinearLayout>
