<?xml version="1.0" encoding="utf-8"?>
<!-- 应用属性弹窗布局 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llRoot"
    android:layout_width="@dimen/toolbar_app_info_width"
    android:layout_height="wrap_content"
    android:background="@drawable/toolbar_shape_dialog_bg"
    android:orientation="vertical"
    android:padding="@dimen/toolbar_app_info_padding">

    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="@dimen/toolbar_app_info_icon_size"
            android:layout_height="@dimen/toolbar_app_info_icon_size"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/toolbar_app_info_header_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/toolbar_white"
                android:textSize="@dimen/toolbar_app_info_name_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppPackage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/toolbar_white_60"
                android:textSize="@dimen/toolbar_app_info_sub_text_size" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/vDivider"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="@dimen/toolbar_app_info_divider_margin"
        android:layout_marginBottom="@dimen/toolbar_app_info_divider_margin"
        android:background="#33FFFFFF" />

    <ScrollView
        android:id="@+id/svInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/llInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/llBtns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/toolbar_app_info_divider_margin"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="@dimen/toolbar_app_info_btn_height"
            android:layout_weight="1"
            android:background="@drawable/toolbar_btn_bg"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:text="@string/toolbar_info_clear_data"
            android:textColor="@color/toolbar_white"
            android:textSize="@dimen/toolbar_app_info_btn_text_size" />

        <Space
            android:layout_width="@dimen/toolbar_app_info_btn_gap"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnCopy"
            android:layout_width="0dp"
            android:layout_height="@dimen/toolbar_app_info_btn_height"
            android:layout_weight="1"
            android:background="@drawable/toolbar_btn_bg"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:text="@string/toolbar_info_copy"
            android:textColor="@color/toolbar_white"
            android:textSize="@dimen/toolbar_app_info_btn_text_size" />
    </LinearLayout>
</LinearLayout>
